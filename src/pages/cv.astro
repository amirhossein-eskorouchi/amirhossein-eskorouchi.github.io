---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="CV and Résumé | Amirhossein Eskorouchi"
  description="Academic and industry application documents for Amirhossein Eskorouchi."
>
  <article class="page">
    <header class="page-header">
      <h1 class="page-title">CV &amp; Résumé</h1>
      <p class="page-introduction">
        Academic and industry-oriented professional documents.
      </p>
    </header>

    <p class="note">
      We will add the final PDF files after their filenames and public versions are
      standardized. This prevents the website from publishing outdated drafts or
      broken document links.
    </p>

    <section class="content-section">
      <h2>Professional documents</h2>

      <ul class="document-list">
        <li>
          <strong>Academic Curriculum Vitae</strong>
          <span>PDF link to be added</span>
        </li>
        <li>
          <strong>Industry Résumé</strong>
          <span>PDF link to be added</span>
        </li>
        <li>
          <strong>Research Statement</strong>
          <span>PDF link to be added</span>
        </li>
        <li>
          <strong>Teaching Statement</strong>
          <span>PDF link to be added</span>
        </li>
      </ul>
    </section>

    <section class="content-section">
      <h2>Profiles</h2>

      <p>
        <a href="https://github.com/amirhossein-eskorouchi" target="_blank" rel="noreferrer">
          GitHub
        </a>
        ·
        <a
          href="https://www.linkedin.com/in/amirhossein-eskorouchii/"
          target="_blank"
          rel="noreferrer"
        >
          LinkedIn
        </a>
        ·
        <a href="mailto:amir.skoruchi@gmail.com">Email</a>
      </p>
    </section>
  </article>
</BaseLayout>
