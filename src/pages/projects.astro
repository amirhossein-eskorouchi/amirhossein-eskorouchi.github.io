---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Projects | Amirhossein Eskorouchi"
  description="Selected research, software, and intelligent-system projects by Amirhossein Eskorouchi."
>
  <article class="page">
    <header class="page-header">
      <h1 class="page-title">Projects</h1>

      <p class="page-introduction">
        Selected research, software, and intelligent-system projects spanning
        manufacturing, healthcare, agriculture, biomedical signal analysis,
        and engineering decision support.
      </p>
    </header>

    <div class="project-list">
      <section class="project-item" id="uot-detr">
        <div class="project-label">Manufacturing AI</div>

        <div>
          <h2>
            <a href="/projects/uot-detr">
              Distributionally Constrained Visual Measurement with UOT-DETR
            </a>
          </h2>

          <p>
            A computer-vision framework that integrates unbalanced optimal
            transport with DETR training to improve wood-chip detection and
            size-distribution estimation for manufacturing quality monitoring.
          </p>

          <p>
            <a href="/projects/uot-detr">Project page</a>
            <span aria-hidden="true"> &middot; </span>
            <a
              href="https://github.com/amirhossein-eskorouchi/UOT-DETR"
              target="_blank"
              rel="noreferrer"
            >
              Code
            </a>
            <span aria-hidden="true"> &middot; </span>
            <a
              href="https://doi.org/10.5281/zenodo.18392693"
              target="_blank"
              rel="noreferrer"
            >
              Dataset
            </a>
          </p>
        </div>
      </section>

      <section class="project-item" id="knowledge-informed-ece">
        <div class="project-label">Medical AI</div>

        <div>
          <h2>
            <a href="/projects/knowledge-informed-ece">
              Knowledge-Informed Constrained Learning for Extracapsular
              Extension Assessment
            </a>
          </h2>

          <p>
            A knowledge-informed 3D medical-imaging framework that embeds
            lymph-node anatomy into representation learning and classification,
            combines mask-guided feature aggregation with self-supervised
            pretraining, and produces clinically grounded ECE predictions under
            limited supervision.
          </p>

          <p>
            <a href="/projects/knowledge-informed-ece">Project page</a>
            <span aria-hidden="true"> &middot; </span>
            <a
              href="https://github.com/amirhossein-eskorouchi/Knowledge-Informed-ECE"
              target="_blank"
              rel="noreferrer"
            >
              Code
            </a>
            <span aria-hidden="true"> &middot; </span>
            <a
              href="https://www.researchgate.net/profile/Amirhossein-Eskorouchi-2/publication/392593672_Knowledge-Informed_Automated_Extracapsular_Extension_Detection_in_Head_and_Neck_Cancer/links/689bede6daa95834904ecd69/Knowledge-Informed-Automated-Extracapsular-Extension-Detection-in-Head-and-Neck-Cancer.pdf"
              target="_blank"
              rel="noreferrer"
            >
              Manuscript
            </a>
          </p>
        </div>
      </section>

      <section class="project-item" id="wood-chip-monitor">
        <div class="project-label">Edge AI</div>

        <div>
          <h2>
            <a href="/projects/wood-chip-monitor">
              Wood-Chip Monitor: Real-Time Edge-AI Quality Evaluation
            </a>
          </h2>

          <p>
            A portable NVIDIA Jetson and TensorRT platform that converts
            streaming RGB imagery into physical chip measurements,
            size-distribution analytics, oversize alerts, moisture estimates,
            and operator-facing decision support for biomass manufacturing.
          </p>

          <p>
            <a href="/projects/wood-chip-monitor">Project page</a>
            <span aria-hidden="true"> &middot; </span>
            <a
              href="https://github.com/amirhossein-eskorouchi/Wood-Chip-Monitor"
              target="_blank"
              rel="noreferrer"
            >
              Code
            </a>
            <span aria-hidden="true"> &middot; </span>
            <a
              href="https://youtu.be/qj1mIFlJkpU"
              target="_blank"
              rel="noreferrer"
            >
              Demo
            </a>
            <span aria-hidden="true"> &middot; </span>
            <a
              href="https://www.researchgate.net/profile/Amirhossein-Eskorouchi-2/publication/403332259_An_Edge_Artificial_Intelligence_System_for_Wood_Chip_Quality_Evaluation/links/69cbe89c60c0371a60f4e48f/An-Edge-Artificial-Intelligence-System-for-Wood-Chip-Quality-Evaluation.pdf"
              target="_blank"
              rel="noreferrer"
            >
              Paper
            </a>
          </p>
        </div>
      </section>

      <section class="project-item" id="plantlife365">
        <div class="project-label">Smart Agriculture</div>

        <div>
          <h2>
            <a href="/projects/plantlife365">
              PlantLife365: Multimodal Plant Health Monitoring and Decision
              Support
            </a>
          </h2>

          <p>
            An IoT-enabled research platform connecting ESP32 environmental
            sensing and optional imaging with authenticated data ingestion,
            user-scoped monitoring, historical visualization, alerts, data
            export, exploratory machine-learning analytics, and an optional
            local AI assistant.
          </p>

          <p>
            <a href="/projects/plantlife365">Project page</a>
            <span aria-hidden="true"> &middot; </span>
            <a
              href="https://github.com/amirhossein-eskorouchi/PlantLife365"
              target="_blank"
              rel="noreferrer"
            >
              Code
            </a>
            <span aria-hidden="true"> &middot; </span>
