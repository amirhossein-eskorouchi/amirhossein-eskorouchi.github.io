              target="_blank"
              rel="noreferrer"
            >
              First Place, 2026 IISE DAIS Competition
            </a>
          </p>
        </div>
      </section>



      <section class="project-item" id="adhd-analysis">
        <div class="project-label">Biomedical Signal Analysis</div>

        <div>
          <h2>
            <a href="/projects/ml-psg-adhd">
              Graph-Based Polysomnography Analysis for Sleep-Stage-Specific
              ADHD Biomarkers
            </a>
          </h2>

          <p>
            A graph-based machine-learning workflow that transforms
            multichannel polysomnography recordings into sleep-stage-specific
            connectivity features and evaluates their value for distinguishing
            ADHD and control participants.
          </p>

          <p>
            <a href="/projects/ml-psg-adhd">Project page</a>
            <span aria-hidden="true"> &middot; </span>
            <a
              href="https://github.com/amirhossein-eskorouchi/ML-PSG-ADHD-Analysis"
