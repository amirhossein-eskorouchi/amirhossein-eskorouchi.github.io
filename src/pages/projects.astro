        </div>
      </section>

      <section class="project-item" id="dynamic-building-risk-analysis">
        <div class="project-label">Decision Support</div>

        <div>
          <h2>
            <a href="/projects/dynamic-building-risk-analysis">
              Dynamic Building Risk Analysis
            </a>
          </h2>

          <p>
            An interactive multi-hazard dashboard for exploring potential
            damage, expected annual risk, discounted cumulative exposure, and
            geospatial context for configurable building scenarios.
          </p>

          <p>
            <a href="/projects/dynamic-building-risk-analysis">
