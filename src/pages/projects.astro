---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Projects | Amirhossein Eskorouchi"
  description="Research and engineering projects by Amirhossein Eskorouchi."
>
  <article class="page">
    <header class="page-header">
      <h1 class="page-title">Projects</h1>
      <p class="page-introduction">
        Selected research, software, and intelligent-system projects.
      </p>
    </header>

    <div class="project-list">
      <section class="project-item" id="uot-detr">
        <div class="project-label">Manufacturing AI</div>

        <div>
          <h2>
            Distributionally Constrained Visual Measurement with UOT-DETR
          </h2>

          <p>
            A computer-vision framework for wood-chip detection and size-distribution
            estimation in manufacturing quality monitoring. The method integrates
            unbalanced optimal transport with DETR training to improve measurement
            of challenging small objects.
          </p>

          <p>
            <a href="https://github.com/amirhossein-eskorouchi" target="_blank" rel="noreferrer">
              GitHub profile
            </a>
          </p>
        </div>
      </section>

      <section class="project-item" id="knowledge-informed-ece">
        <div class="project-label">Medical AI</div>

        <div>
          <h2>
            Knowledge-Informed Constrained Learning for Extracapsular Extension
            Assessment
          </h2>

          <p>
            A knowledge-informed 3D medical-imaging framework that embeds
            lymph-node anatomy into representation learning and classification,
            combines mask-guided feature aggregation with self-supervised
            pretraining, and produces clinically grounded ECE predictions under
            limited supervision.
          </p>

          <p>
            <a href="/projects/knowledge-informed-ece">Project page</a>
            <span aria-hidden="true"> · </span>
            <a
              href="https://github.com/amirhossein-eskorouchi/Knowledge-Informed-ECE"
              target="_blank"
              rel="noreferrer"
            >
              Code
            </a>
          </p>
        </div>
      </section>

      <section class="project-item" id="wood-chip-monitor">
        <div class="project-label">Edge AI</div>

        <div>
          <h2>Wood-Chip Monitor</h2>

          <p>
            A deployment-oriented intelligent monitoring system connecting computer
            vision, physical measurements, data management, and engineering interfaces
            for wood-chip quality evaluation.
          </p>
        </div>
      </section>

      <section class="project-item" id="plantlife365">
        <div class="project-label">Intelligent Application</div>

        <div>
          <h2>PlantLife365</h2>

          <p>
            An intelligent application for plant identification and care support.
            PlantLife365 received First Place in the IISE Data Analytics &amp;
            Information Systems Division Student Mobile App Competition.
          </p>

          <p>
            <a
              href="https://www.iise.org/Details.aspx?id=33697#:~:text=Amirhossein%20Eskorouchi"
              target="_blank"
              rel="noreferrer"
            >
              Award information
            </a>
          </p>
        </div>
      </section>

      <section class="project-item" id="ag-mavs">
        <div class="project-label">Agricultural Robotics</div>

        <div>
          <h2>Sim-to-Real Stereo Depth Adaptation for Agricultural RGB-D SLAM</h2>

          <p>
            Research on adapting learned stereo depth from simulation to real
            agricultural environments and evaluating the resulting depth estimates
            within RGB-D SLAM pipelines.
          </p>
        </div>
      </section>

      <section class="project-item" id="adhd-analysis">
        <div class="project-label">Health Analytics</div>

        <div>
          <h2>Machine Learning and PSG Analysis for ADHD Research</h2>

          <p>
            A reproducible analysis pipeline connecting polysomnography-derived
            variables, network analysis, machine learning, and interpretable
            feature evaluation.
          </p>

          <p>
            <a
              href="https://github.com/amirhossein-eskorouchi/ML-PSG-ADHD-Analysis"
              target="_blank"
              rel="noreferrer"
            >
              Code
            </a>
          </p>
        </div>
      </section>

      <section class="project-item" id="building-risk">
        <div class="project-label">Decision Support</div>

        <div>
          <h2>Dynamic Building Risk Analysis</h2>

          <p>
            A data-driven decision-support project for analyzing and communicating
            changing building-risk conditions.
          </p>

          <p>
            <a
              href="https://github.com/amirhossein-eskorouchi/Dynamic-Building-Risk-Analysis"
              target="_blank"
              rel="noreferrer"
            >
              Code
            </a>
          </p>
        </div>
      </section>
    </div>
  </article>
</BaseLayout>
